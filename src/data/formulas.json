{
  "schemaVersion": 1,
  "formulas": {
    "atk": "STR + floor(DEX/5) + floor(LUK/5) + weaponATK",
    "matk": "INT*1.5 + floor((INT*INT)/100)",
    "def": "floor(VIT*0.8) + floor(STR/10)",
    "mdef": "floor(INT*0.7) + floor(VIT*0.3)",
    "hit": "baseLevel + DEX",
    "flee": "baseLevel + AGI",
    "perfectDodge": "floor(LUK/10) + passiveFlee",
    "crit": "1 + LUK*0.3 + passiveCrit",
    "critResistance": "floor(VIT/5) + floor(LUK/10)",
    "aspd": "classBaseAspd + AGI*0.0025",
    "maxHp": "(classBaseHp * baseLevel * classHpPerLevel) * (1 + VIT/100)",
    "maxSp": "(classBaseSp * baseLevel * classSpPerLevel) * (1 + INT/150)",
    "hpRegen": "1 + floor(VIT/5) + floor(MaxHP/200)",
    "spRegen": "1 + floor(INT/6) + floor(MaxSP/100)",
    "maxWeight": "classBaseWeight + STR*30 + VIT*10 + passiveWeight",
    "attackRange": "classAttackRange",
    "physical_basic": "max(1,(ATK * skillMultiplier * elementMultiplier * sizeMultiplier * raceMultiplier) - DEF)",
    "magical_basic": "max(1,(MATK * skillMultiplier * elementMultiplier * sizeMultiplier * raceMultiplier) - MDEF)",
    "heal_basic": "max(1,MATK * healMultiplier)"
